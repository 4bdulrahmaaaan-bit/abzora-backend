PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/abzora
MONGO_MAX_POOL_SIZE=120
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_RETRY_WRITES=true
MONGO_RETRY_READS=true
MONGO_WAIT_QUEUE_TIMEOUT_MS=2000
MONGO_CONNECT_MAX_ATTEMPTS=8
MONGO_CONNECT_RETRY_BASE_MS=800
MONGO_CONNECT_RETRY_MAX_MS=15000
MONGO_POOL_SATURATION_THRESHOLD=0.95
MONGO_POOL_TIMEOUT_WINDOW_MS=30000
CLIENT_ORIGIN=http://localhost:3000
ALLOWED_ADMIN_EMAILS=yourmail@gmail.com,secondadmin@gmail.com

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=abzora

RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false
REDIS_REQUIRED=true
RATE_LIMIT_FAIL_CLOSED=true
OPS_LOCK_FAIL_CLOSED=true
ENFORCE_HTTPS=true
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
REQUIRE_EMAIL_VERIFICATION=true
AUTH_MAX_SESSION_AGE_MINUTES=480
ENABLE_TEST_AUTH_ROUTES=false

OPS_RUNTIME_ENABLED=true
OPS_DETECTION_INTERVAL_MS=30000
OPS_ESCALATION_INTERVAL_MS=120000
OPS_ESCALATION_THRESHOLD_MIN=20
OPS_DEAD_THRESHOLD_MIN=35
OPS_WORKER_CONCURRENCY=4
OPS_ACTION_MAX_RETRIES=3
OPS_WORKER_SATURATION_GATE_PCT=97
OPS_QUEUE_GLOBAL_MAX=5000
OPS_QUEUE_CRITICAL_MAX=1500
OPS_QUEUE_HIGH_MAX=1500
OPS_QUEUE_MEDIUM_MAX=1200
OPS_QUEUE_LOW_MAX=800
OPS_QUEUE_OVERLOAD_POLICY=defer
OPS_QUEUE_SHED_NON_CRITICAL=true
OPS_QUEUE_DEFER_MS=3000
OPS_QUEUE_RETRY_PROMOTE_PER_TICK=30
OPS_QUEUE_RETRY_CONCURRENCY_CAP=2
OPS_QUEUE_RETRY_JITTER_MS=750
OPS_QUEUE_PER_TENANT_WINDOW_MAX=200
OPS_QUEUE_PER_TENANT_WINDOW_MS=60000
OPS_QUEUE_SATURATION_ALERT_PCT=85
OPS_QUEUE_RETRY_BACKLOG_ALERT=300
OPS_QUEUE_LAG_ALERT_MS=15000
OPS_TIMEOUT_VENDOR_ACCEPT_MIN=8
OPS_TIMEOUT_RIDER_ACCEPT_MIN=7
OPS_TIMEOUT_PICKUP_MIN=25
OPS_TIMEOUT_DELIVERY_MIN=90
OPS_HOURLY_METRICS_MS=3600000
OPS_DAILY_METRICS_MS=86400000

TRACKING_MOVEMENT_THRESHOLD_METERS=12
TRACKING_MAX_SPEED_KMPH=120
TRACKING_THROTTLE_SECONDS=4
TRACKING_SNAP_TO_ROAD=false
ALLOW_WS_QUERY_TOKEN=false
WEBHOOK_LOCK_TTL_SECONDS=604800
PAYMENT_WEBHOOK_INGEST_WORKER_ENABLED=true
PAYMENT_WEBHOOK_INGEST_POLL_INTERVAL_MS=500
PAYMENT_WEBHOOK_INGEST_BATCH_SIZE=20
PAYMENT_WEBHOOK_INGEST_CONCURRENCY=6
PAYMENT_WEBHOOK_INGEST_LEASE_MS=15000
PAYMENT_WEBHOOK_INGEST_MAX_ATTEMPTS=8
PAYMENT_WEBHOOK_INGEST_CLEANUP_EVERY_MS=600000
PAYMENT_WEBHOOK_INGEST_RETENTION_MS=172800000
