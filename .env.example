PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/abzora
CLIENT_ORIGIN=http://localhost:3000
ALLOWED_ADMIN_EMAILS=yourmail@gmail.com,secondadmin@gmail.com

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=abzora

RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false
ENFORCE_HTTPS=true
REQUIRE_EMAIL_VERIFICATION=true
AUTH_MAX_SESSION_AGE_MINUTES=480
ENABLE_TEST_AUTH_ROUTES=false

OPS_RUNTIME_ENABLED=true
OPS_DETECTION_INTERVAL_MS=30000
OPS_ESCALATION_INTERVAL_MS=120000
OPS_ESCALATION_THRESHOLD_MIN=20
OPS_DEAD_THRESHOLD_MIN=35
OPS_WORKER_CONCURRENCY=4
OPS_ACTION_MAX_RETRIES=3
OPS_TIMEOUT_VENDOR_ACCEPT_MIN=8
OPS_TIMEOUT_RIDER_ACCEPT_MIN=7
OPS_TIMEOUT_PICKUP_MIN=25
OPS_TIMEOUT_DELIVERY_MIN=90
OPS_HOURLY_METRICS_MS=3600000
OPS_DAILY_METRICS_MS=86400000

TRACKING_MOVEMENT_THRESHOLD_METERS=12
TRACKING_MAX_SPEED_KMPH=120
TRACKING_THROTTLE_SECONDS=4
TRACKING_SNAP_TO_ROAD=false
